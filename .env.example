MONGODB_URI=
# Alternatively, enter the Atlas password without editing a connection string.
# When MONGODB_PASSWORD is set, these fields take priority over MONGODB_URI.
MONGODB_HOST=
MONGODB_USER=calendario_app
MONGODB_PASSWORD=
MONGODB_DB=calendario_examenes
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
# Local development. In Vercel use the final HTTPS domain, without a trailing slash.
BETTER_AUTH_URL=http://localhost:3000
